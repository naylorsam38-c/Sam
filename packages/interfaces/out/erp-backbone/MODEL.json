 "workflows": {
  "Purchase order lifecycle": {
   "stages": [
    "Draft",
    "Confirmed",
    "Received",
    "Closed",
    "Cancelled"
   ],
   "initial": "Draft",
   "terminal": [
    "Closed",
    "Cancelled"
   ],
   "transitions": [
    {
     "from": "Draft",
     "to": "Confirmed",
     "mover": "roles",
     "roles": [
      "Purchasing"
     ]
    },
    {
     "from": "Confirmed",
     "to": "Received",
     "mover": "roles",
     "roles": [
      "Warehouse"
     ]
    },
    {
     "from": "Received",
     "to": "Closed",
     "mover": "roles",
     "roles": [
      "Operations"
     ]
    }
   ],
   "approvals": [
    {
     "stage": "Draft",
     "approvers": [
      "Operations"
     ]
    }
   ],
   "on_reject": {
    "back_to": "Draft",
    "resubmit": "yes"
   },
   "effects": [
    {
     "on_enter": "Received",
     "op": "apply_order_lines",
     "line_table": "purchase_order_lines",
     "line_fk": "purchase_order",
     "product_table": "products",
     "product_fk": "product",
     "quantity_column": "quantity",
     "direction": "receive"
    }
   ]
  },
  "Sales order lifecycle": {
   "stages": [
    "Draft",
    "Confirmed",
    "Shipped",
    "Closed",
    "Cancelled"
   ],
   "initial": "Draft",
   "terminal": [
    "Closed",
    "Cancelled"
   ],
   "transitions": [
    {
     "from": "Draft",
     "to": "Confirmed",
     "mover": "roles",
     "roles": [
      "Sales"
     ]
    },
    {
     "from": "Confirmed",
     "to": "Shipped",
     "mover": "roles",
     "roles": [
      "Warehouse"
     ]
    },
    {
     "from": "Shipped",
     "to": "Closed",
     "mover": "roles",
     "roles": [
      "Operations"
     ]
    }
   ],
   "approvals": [],
   "on_reject": null,
   "effects": [
    {
     "on_enter": "Shipped",
     "op": "apply_order_lines",
     "line_table": "sales_order_lines",
     "line_fk": "sales_order",
     "product_table": "products",
     "product_fk": "product",
     "quantity_column": "quantity",
     "direction": "ship"
    }
   ]
  }
 },
 "forms": {},
 "reports": {
  "Stock on hand": {
   "slug": "stock_on_hand",
   "question": "What do we hold right now, and what is at or below its reorder point?",
   "metrics": [
    "sum of Product Stock on hand",
    "count of Products at or below Reorder point"
   ],
   "specs": [
    {
     "metric": "sum of Product Stock on hand",
     "spec": {
      "table": "products",
      "aggregation": "sum",
      "value_field": "stock_on_hand"
     }
    },
    {
     "metric": "count of Products at or below Reorder point",
     "spec": {
      "engine": "stock_ledger",
      "kind": "count_at_or_below_reorder",
      "table": "products",
      "stock_column": "stock_on_hand",
      "reorder_column": "reorder_point"
     }
    }
   ]
  },
  "Sales by month": {
   "slug": "sales_by_month",
   "question": "What did we sell, month by month?",
   "metrics": [
    "sales value"
   ],
   "specs": [
    {
     "metric": "sales value",
     "spec": {
      "engine": "stage_history",
      "kind": "line_value_by_month",
      "table": "sales_orders",
      "stage": "Shipped",
      "line_table": "sales_order_lines",
      "line_fk": "sales_order",
      "quantity_column": "quantity",
      "price_column": "unit_price",
      "months": 12
     }
    }
   ]
  },
  "Open orders": {
   "slug": "open_orders",
   "question": "What is confirmed but not yet fulfilled, on both sides?",
   "metrics": [
    "count of Sales orders in Confirmed",
    "count of Purchase orders in Confirmed"
   ],
   "specs": [
    {
     "metric": "count of Sales orders in Confirmed",
     "spec": {
      "table": "sales_orders",
      "aggregation": "count",
      "filters": [
       {
        "field": "stage",
        "op": "=",
        "value": "Confirmed"
       }
      ]
     }
    },
    {
     "metric": "count of Purchase orders in Confirmed",
     "spec": {
      "table": "purchase_orders",
      "aggregation": "count",
      "filters": [
       {
        "field": "stage",
        "op": "=",
        "value": "Confirmed"
       }
      ]
     }
    }
   ]
  }
 },

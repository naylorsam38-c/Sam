 "workflows": {
  "Appointment lifecycle": {
   "stages": [
    "Booked",
    "Confirmed",
    "Completed",
    "Cancelled",
    "No-show"
   ],
   "initial": "Booked",
   "terminal": [
    "Completed",
    "Cancelled",
    "No-show"
   ],
   "transitions": [
    {
     "from": "Booked",
     "to": "Confirmed",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Confirmed",
     "to": "Completed",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Confirmed",
     "to": "No-show",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Booked",
     "to": "Cancelled",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Confirmed",
     "to": "Cancelled",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    }
   ],
   "approvals": [],
   "on_reject": null,
   "effects": []
  }
 },
 "forms": {
  "Public booking form": {
   "record": "Appointment",
   "slug": "public_booking_form",
   "fields": [
    "service",
    "customer",
    "staff_member",
    "start",
    "notes",
    "deposit_paid"
   ]
  }
 },
 "reports": {
  "Upcoming appointments": {
   "slug": "upcoming_appointments",
   "question": "What's booked for the coming days, per staff member?",
   "metrics": [
    "count of Appointments in stage Booked or Confirmed"
   ],
   "specs": [
    {
     "metric": "count of Appointments in stage Booked or Confirmed",
     "spec": {
      "table": "appointments",
      "aggregation": "count",
      "filters": [
       {
        "field": "stage",
        "op": "in",
        "value": [
         "Booked",
         "Confirmed"
        ]
       },
       {
        "field": "start",
        "op": "within_next_days",
        "value": 7
       }
      ]
     }
    }
   ]
  },
  "No-show rate": {
   "slug": "no_show_rate",
   "question": "How often do customers fail to turn up?",
   "metrics": [
    "no-show rate"
   ],
   "specs": [
    {
     "metric": "no-show rate",
     "spec": {
      "engine": "stage_history",
      "kind": "rate_over_last_days",
      "table": "appointments",
      "numerator_stage": "No-show",
      "denominator_stages": [
       "Completed",
       "No-show"
      ],
      "days": 30
     }
    }
   ]
  }
 },

  "reports": {
   "Open tasks by person": {
    "data_source": "Who is carrying how much open work right now?",
    "metrics": {
     "count of Tasks not in stage Done, grouped by Assignee": "auto: count/sum of 'count of Tasks not in stage Done, grouped by Assignee'"
    },
    "spec": [
     {
      "metric": "count of Tasks not in stage Done, grouped by Assignee",
      "spec": {
       "table": "tasks",
       "aggregation": "count",
       "group_by": "assignee",
       "filters": [
        {
         "field": "stage",
         "op": "!=",
         "value": "Done"
        }
       ]
      }
     }
    ],
    "id": "pm-teamwork/RPT-001"
   },
   "Overdue tasks": {
    "data_source": "What has slipped past its due date and needs chasing?",
    "metrics": {
     "count of overdue Tasks": "a Task counts as overdue when Due date is before today AND its stage is not Done, as at the moment the report is viewed"
    },
    "spec": [
     {
      "metric": "count of overdue Tasks",
      "spec": {
       "table": "tasks",
       "aggregation": "count",
       "filters": [
        {
         "field": "due_date",
         "op": "before_now"
        },
        {
         "field": "stage",
         "op": "!=",
         "value": "Done"
        }
       ]
      }
     }
    ],
    "id": "pm-teamwork/RPT-002"
   }

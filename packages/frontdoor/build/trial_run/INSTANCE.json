 "report_specs": {
  "Open tasks by person": [
   {
    "metric": "count of Tasks not in stage Done, grouped by Assignee",
    "spec": {
     "table": "tasks",
     "aggregation": "count",
     "group_by": "assignee",
     "filters": [
      {
       "field": "stage",
       "op": "!=",
       "value": "Done"
      }
     ]
    }
   }
  ],
  "Overdue tasks": [
   {
    "metric": "count of overdue Tasks",
    "spec": {
     "table": "tasks",
     "aggregation": "count",
     "filters": [
      {
       "field": "due_date",
       "op": "before_now"
      },
      {
       "field": "stage",
       "op": "!=",
       "value": "Done"
      }
     ]
    }
   }
  ]
 },

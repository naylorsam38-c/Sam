     ]
    },
    {
     "from": "Negotiation",
     "to": "Won",
     "mover": "roles",
     "roles": [
      "Sales rep",
      "Sales manager"
     ]
    },
    {
     "from": "Lead in",
     "to": "Lost",
     "mover": "roles",
     "roles": [
      "Sales rep",
      "Sales manager"
     ]
    },
    {
     "from": "Contacted",
     "to": "Lost",
     "mover": "roles",
     "roles": [
      "Sales rep",
      "Sales manager"
     ]
    },
    {
     "from": "Proposal sent",
     "to": "Lost",
     "mover": "roles",
     "roles": [
      "Sales rep",
      "Sales manager"
     ]
    },
    {
     "from": "Negotiation",
     "to": "Lost",
     "mover": "roles",
     "roles": [
      "Sales rep",
      "Sales manager"
     ]
    }
   ],
   "approvals": [],
   "on_reject": null,
   "effects": []
  }
 },
 "forms": {},
 "reports": {
  "Pipeline by stage": {
   "slug": "pipeline_by_stage",
   "question": "How much potential value sits in each stage of the pipeline?",
   "metrics": [
    "sum of open Deal Value grouped by stage",
    "count of Deals grouped by stage"
   ],
   "specs": [
    {
     "metric": "sum of open Deal Value grouped by stage",
     "spec": {
      "table": "deals",
      "aggregation": "sum",
      "value_field": "value",
      "group_by": "stage",
      "filters": [
       {
        "field": "stage",
        "op": "not_in",
        "value": [
         "Won",
         "Lost"
        ]
       }
      ]
     }
    },
    {
     "metric": "count of Deals grouped by stage",
     "spec": {
      "table": "deals",
      "aggregation": "count",
      "group_by": "stage"
     }
    }
   ]
  },
  "Win rate": {
   "slug": "win_rate",
   "question": "Of the deals we finish, what share do we win?",
   "metrics": [
    "win rate"
   ],
   "specs": [
    {
     "metric": "win rate",
     "spec": {
      "engine": "stage_history",
      "kind": "rate_over_last_days",
      "table": "deals",
      "numerator_stage": "Won",
      "denominator_stages": [
       "Won",
       "Lost"
      ],
      "days": 90
     }
    }
   ]
  }
 },

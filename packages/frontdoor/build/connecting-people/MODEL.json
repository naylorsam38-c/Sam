 "workflows": {
  "Deal pipeline": {
   "stages": [
    "Lead in",
    "Contacted",
    "Proposal sent",
    "Negotiation",
    "Won",
    "Lost"
   ],
   "initial": "Lead in",
   "terminal": [
    "Won",
    "Lost"
   ],
   "transitions": [
    {
     "from": "Lead in",
     "to": "Contacted",
     "mover": "roles",
     "roles": [
      "Sales rep",
      "Sales manager"
     ]
    },
    {
     "from": "Contacted",
     "to": "Proposal sent",
     "mover": "roles",

 "workflows": {
  "Appointment lifecycle": {
   "stages": [
    "Booked",
    "Confirmed",
    "Completed",
    "Cancelled",
    "No-show"
   ],
   "initial": "Booked",
   "terminal": [
    "Completed",
    "Cancelled",
    "No-show"
   ],
   "transitions": [
    {
     "from": "Booked",
     "to": "Confirmed",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Confirmed",
     "to": "Completed",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Confirmed",
     "to": "No-show",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Booked",
     "to": "Cancelled",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    },
    {
     "from": "Confirmed",
     "to": "Cancelled",
     "mover": "roles",
     "roles": [
      "Staff"
     ]
    }
   ],
   "approvals": [],
   "on_reject": null,
   "effects": []
  },
  "Invoice lifecycle": {
   "stages": [
    "Draft",
    "Awaiting approval",
    "Awaiting payment",
    "Paid",
    "Voided"
   ],
   "initial": "Draft",
   "terminal": [
    "Paid",
    "Voided"
   ],
   "transitions": [
    {
     "from": "Draft",
     "to": "Awaiting approval",
     "mover": "roles",
     "roles": [
      "Accountant"
     ]
    },
    {
     "from": "Awaiting approval",
     "to": "Awaiting payment",
     "mover": "roles",
     "roles": [
      "Admin"
     ]
    },
    {
     "from": "Awaiting payment",
     "to": "Paid",
     "mover": "automatic",
     "event": "Payments applied to the invoice reach its total"
    },
    {
     "from": "Awaiting payment",
     "to": "Voided",
     "mover": "roles",
     "roles": [
      "Admin"
     ]
    },
    {
     "from": "Draft",
     "to": "Voided",
     "mover": "roles",
     "roles": [
      "Accountant"
     ]
    }
   ],
   "approvals": [
    {
     "stage": "Awaiting approval",
     "approvers": [
      "Admin"
     ]
    }
   ],
   "on_reject": {
    "back_to": "Draft",
    "resubmit": "yes"
   },
   "effects": []
  },
  "Bill lifecycle": {
   "stages": [
    "Draft",
    "Awaiting payment",
    "Paid",
    "Voided"
   ],
   "initial": "Draft",
   "terminal": [
    "Paid",
    "Voided"
   ],
   "transitions": [
    {
     "from": "Draft",
     "to": "Awaiting payment",
     "mover": "roles",
     "roles": [
      "Accountant"
     ]
    },
    {
     "from": "Awaiting payment",
     "to": "Paid",
     "mover": "automatic",
     "event": "Payments applied to the bill reach its total"
    },
    {
     "from": "Awaiting payment",
     "to": "Voided",
     "mover": "roles",
     "roles": [
      "Admin"
     ]
    },
    {
     "from": "Draft",
     "to": "Voided",
     "mover": "roles",
     "roles": [
      "Accountant"
     ]
    }
   ],
   "approvals": [],
   "on_reject": null,
   "effects": []
  }
 },

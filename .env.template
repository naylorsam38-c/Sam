# Aura environment. Copy to .env. Secrets never go in the image or client.

# Gateway
AURA_TOKEN_SECRET=            # long random string; signs session tokens
AURA_CONFIG=config/aura.yaml
AURA_MAX_SESSIONS=1           # spec §25: one reliable user first

# External brain (your existing Command Desk) — internal network only
AURA_BRAIN_ENDPOINT=http://commanddesk-internal/chat

# Transport (self-hosted LiveKit)
AURA_TRANSPORT_URL=ws://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Models (paths on the GPU host)
AURA_YUNET=models/face_detection_yunet.onnx     # commercial face detector
KOKORO_MODEL_DIR=models/kokoro
MUSETALK_DIR=models/musetalk
LIVEPORTRAIT_DIR=models/liveportrait
GFPGAN_WEIGHTS=models/gfpgan/GFPGANv1.4.pth

# GPU
CUDA_VISIBLE_DEVICES=0

# ── Gateway authentication (REQUIRED in production) ─────────────────────────
# Signing secret for session tokens. The gateway REFUSES TO START without a
# real one — generate with: openssl rand -hex 32
AURA_TOKEN_SECRET=

# Client credentials, as `key:user_id` pairs. The `x-user-id` header alone is
# NOT identity; the user id comes from whichever key authenticated.
AURA_API_KEYS=

# Local development only: bypasses client auth AND secret validation.
# Never set this on anything reachable from the internet.
# AURA_DEV=1

# ── Provider policy: api | selfhosted | auto | offline ──────────────────────
AURA_PROVIDER_POLICY=auto

# ── Hosted provider keys (only needed for policy=api, or auto without a GPU) ─
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
SIMLI_API_KEY=
SIMLI_FACE_ID=

# ── Self-hosted GPU paths (only needed for policy=selfhosted) ───────────────
# Checkout of MuseTalk with weights already downloaded and pinned.
AURA_MUSETALK_HOME=
# Driving loop built by scripts/make_avatar.py
AURA_DRIVING_VIDEO=

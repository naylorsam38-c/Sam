# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# SQLite by default (single-user deployment). The schema is written to
# support a later move to PostgreSQL without code changes beyond this URL.
# Leave unset for a native (non-Docker) run — workstation_core/config.py
# then defaults to <repo root>/data/workstation.db. docker-compose.yml
# overrides this to sqlite:////data/workstation.db (the container's
# mounted volume) for each service automatically — don't set it here for
# that case, that's what the compose file's own `environment:` block is for.
# DATABASE_URL=sqlite:////data/workstation.db

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-to-a-long-random-value

# --- Local Ollama (runs on the laptop) ---
# If you run the control API / worker natively (not via docker-compose),
# leave this as localhost. If you run them via `docker compose up`, set
# this to http://host.docker.internal:11434 instead so the containers can
# reach Ollama on the host (docker-compose.yml wires the required
# extra_hosts entry for this on Linux automatically).
OLLAMA_LOCAL_URL=http://localhost:11434

# --- Cloud inference (runs on the rented GPU) ---
# Leave CLOUD_LLM_BASE_URL empty until the GPU has been started at least
# once and you have its endpoint (control plane fills this in automatically
# once GPU status becomes READY; set it manually only for a fixed/static
# cloud endpoint that isn't managed by the GPU lifecycle).
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
# "ollama" or "vllm" — must match what gpu/image installs on the GPU.
CLOUD_LLM_ENGINE=ollama

# --- Cloud GPU provider ---
# mock (dev/test only) | runpod | vast (not implemented) | lambdalabs (not implemented)
GPU_PROVIDER=mock
GPU_PROVIDER_API_KEY=
GPU_TEMPLATE_ID=
GPU_VOLUME_ID=

# --- GPU lifecycle / cost controls ---
GPU_IDLE_TIMEOUT_MINUTES=20
GPU_MAX_SESSION_MINUTES=240
GPU_MAX_HOURLY_COST=2.00
GPU_AUTO_STOP=true
GPU_AUTO_START=true
GPU_ESTIMATED_HOURLY_COST=0.50

# --- Worker -> control API channel ---
# Not part of the spec's literal env var list, but required by the worker
# to ask the control API to start/stop the GPU (only the control API
# process owns the live provider connection).
CONTROL_API_URL=http://localhost:8000

# --- Task queue / worker ---
TASK_MAX_RETRIES=3
TASK_TIMEOUT_SECONDS=900
WORKER_POLL_INTERVAL_SECONDS=2
GPU_MONITOR_INTERVAL_SECONDS=30

# --- Local execution agent ---
# EXECUTION_AGENT_URL is where the control plane reaches the agent running
# on the laptop. EXECUTION_AGENT_TOKEN is the shared HMAC secret used to
# sign every request between them (see docs/SECURITY.md) — it must match
# on both sides and must be different from AUTH_SECRET. Under
# docker-compose, set this to http://host.docker.internal:8787 (the agent
# itself should still run natively — see local-agent/Dockerfile).
EXECUTION_AGENT_URL=http://localhost:8787
EXECUTION_AGENT_PUBLIC_KEY=
EXECUTION_AGENT_TOKEN=change-me-to-a-different-long-random-value

# --- Notifications ---
NOTIFICATION_ENABLED=true

# --- Open WebUI cloud proxy ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Point Open WebUI's "Ollama API" connection at
# http://<control-host>:8000/proxy/cloud with this value as its API key —
# it then keeps working across cloud GPU restarts without needing the IP
# updated by hand (see docs/OPERATIONS.md).
OPEN_WEBUI_PROXY_TOKEN=

# --- Admin bootstrap (used only by database/seeds/seed_admin.py) ---
WORKSTATION_ADMIN_USERNAME=admin
WORKSTATION_ADMIN_PASSWORD=
